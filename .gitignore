# Local game binaries (GOG installers, extracted assets)
.games/

# Brandon's private test-install staging area (GOG installers).
/testing_facility/

# Upstream reference repos cloned for reverse-engineering research.
# Each is its own checkout under a dot-prefixed directory.
.dsun_music/
.dsoageofheroes/
.dso-online/

# Build artifacts
/build/
/target/
*.o
*.obj
*.exe

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.cache/

# Extracted/derived assets used for analysis but not redistributable
/extracted/
/scratch/

# Generated Ghidra scripts (ovr-map --ghidra). Regenerate instead of
# editing; see docs/dsun-exe-re.md 7 for the headless recipe.
/OvrMap.java

# Python bytecode caches
__pycache__/
*.pyc

# Played-save fixtures for save-inspect / repro work. Each
# session's saves live under a per-save directory; the contents
# are user-specific game state, not part of the repo.
/tools/save-inspect/test-saves/
